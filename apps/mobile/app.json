{
  "expo": {
    "name": "Fred",
    "slug": "fred",
    "owner": "fred-model-team",
    "version": "0.2.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "newArchEnabled": true,
    "android": {
      "package": "dev.fred.app",
      "largeHeap": false,
      "adaptiveIcon": {
        "foregroundImage": "./assets/android-icon-foreground.png",
        "monochromeImage": "./assets/android-icon-monochrome.png",
        "backgroundColor": "#316C33"
      },
      "versionCode": 3,
      "permissions": [
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION"
      ]
    },
    "ios": {
      "bundleIdentifier": "dev.fred.app",
      "supportsTablet": false,
      "config": {
        "usesNonExemptEncryption": false
      },
      "entitlements": {
        "com.apple.developer.kernel.extended-virtual-addressing": true,
        "com.apple.developer.kernel.increased-memory-limit": true
      },
      "infoPlist": {
        "UIFileSharingEnabled": true,
        "LSSupportsOpeningDocumentsInPlace": true
      }
    },
    "plugins": [
      [
        "llama.rn",
        {
          "forceCxx20": true
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Fred uses your location to pick the right local plant and animal guide. It stays on the device.",
          "locationAlwaysAndWhenInUsePermission": "Fred uses your location to pick the right local plant and animal guide. It stays on the device."
        }
      ],
      "@maplibre/maplibre-react-native",
      [
        "expo-build-properties",
        {
          "ios": {
            "enableSceneSupport": true
          }
        }
      ],
      "./plugins/with-onnxruntime-nuget"
    ],
    "extra": {
      "eas": {
        "projectId": "d60ad82f-30d4-4ceb-9db9-95ca03ebe615"
      }
    }
  }
}

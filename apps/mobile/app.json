{
  "expo": {
    "name": "Fred",
    "slug": "fred",
    "version": "0.1.0",
    "orientation": "portrait",
    "newArchEnabled": true,
    "android": {
      "package": "dev.fred.app",
      "largeHeap": false
    },
    "plugins": [
      [
        "llama.rn",
        {
          "forceCxx20": true
        }
      ],
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "Fred uses your location to pick the right local plant and animal guide. It stays on the device."
        }
      ],
      "@maplibre/maplibre-react-native"
    ]
  }
}

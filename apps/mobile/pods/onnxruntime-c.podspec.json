{
  "name": "onnxruntime-c",
  "version": "1.30.0",
  "authors": {
    "ONNX Runtime": "onnxruntime@microsoft.com"
  },
  "license": {
    "type": "MIT",
    "file": "LICENSE"
  },
  "homepage": "https://github.com/microsoft/onnxruntime",
  "source": {
    "http": "https://api.nuget.org/v3-flatcontainer/microsoft.ml.onnxruntime/1.30.0/microsoft.ml.onnxruntime.1.30.0.nupkg",
    "type": "zip",
    "sha256": "30df119bd9164eaa187666d93147448fdd4a9a1a3caf83f1505daf7af2d1c5d2"
  },
  "prepare_command": "unzip -q -o runtimes/ios/native/onnxruntime.xcframework.zip && mkdir -p Headers && cp onnxruntime.xcframework/ios-arm64/onnxruntime.framework/Headers/*.h Headers/",
  "summary": "ONNX Runtime C/C++ Pod",
  "platforms": {
    "ios": "15.1"
  },
  "vendored_frameworks": "onnxruntime.xcframework",
  "static_framework": true,
  "weak_frameworks": [
    "CoreML"
  ],
  "ios": {
    "frameworks": [
      "CoreFoundation",
      "Foundation",
      "Network",
      "Security",
      "SystemConfiguration",
      "UIKit"
    ]
  },
  "source_files": "Headers/*.h",
  "preserve_paths": [
    "LICENSE"
  ],
  "description": "A pod for the ONNX Runtime C/C++ library.",
  "libraries": "c++",
  "pod_target_xcconfig": {
    "OTHER_CPLUSPLUSFLAGS": "-fvisibility=hidden -fvisibility-inlines-hidden"
  }
}
